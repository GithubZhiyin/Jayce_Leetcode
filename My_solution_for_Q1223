1223. Dice Roll Simulation


class Solution:
    def dieSimulator(self, n: int, rollMax: list[int]) -> int:
        max_t = max(rollMax)

        df = [[[0] * 6 for _ in range(max_t) ] for _ in range(n)]
    
        for k in range(6):
            df[0][0][k] = 1 
        
        for i in range(1, n):
            
            for k in range(6):
                for j in range(min(i, max_t)):
                    for k_ in range(6):
                        if k_ != k:
                            df[i][0][k] += df[i - 1][j][k_]

            for j in range(1, min(i+1, max_t)):
                for k in range(6):
                    if j + 1 <= rollMax[k]:
                        df[i][j][k] = df[i - 1][j - 1][k]
                    else:
                        df[i][j][k] = 0
        
        res = 0
        for j in range(max_t):
            for k in range(6):
                res += df[-1][j][k]
        
        return int(res % (1e9 + 7))
